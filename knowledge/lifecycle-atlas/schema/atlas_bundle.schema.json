{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/scientific-data-lifecycle-atlas.schema.json",
  "title": "Scientific Data Lifecycle Atlas Bundle",
  "type": "object",
  "required": [
    "atlas_version",
    "updated",
    "methodology",
    "stages",
    "failures",
    "standards",
    "metrics",
    "materials_lens",
    "documented_cases",
    "sources",
    "project_sources",
    "claims",
    "project_mapping",
    "project_case"
  ],
  "properties": {
    "atlas_version": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "methodology": {
      "type": "object"
    },
    "stages": {
      "type": "array",
      "minItems": 1
    },
    "failures": {
      "type": "array"
    },
    "standards": {
      "type": "array"
    },
    "metrics": {
      "type": "array"
    },
    "materials_lens": {
      "type": "object"
    },
    "documented_cases": {
      "type": "array"
    },
    "sources": {
      "type": "array"
    },
    "project_sources": {
      "type": "array"
    },
    "claims": {
      "type": "array"
    },
    "project_mapping": {
      "type": "object"
    },
    "project_case": {
      "type": "object"
    },
    "runtime_evidence": {
      "$comment": "Loaded only when knowledge/lifecycle-atlas/runtime_evidence.json exists. It is intentionally optional until a platform test run supplies observed evidence.",
      "$ref": "#/$defs/runtimeEvidence"
    }
  },
  "$defs": {
    "testOutcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "error",
        "skipped",
        "xfailed",
        "xpassed"
      ]
    },
    "testCase": {
      "type": "object",
      "required": [
        "nodeid",
        "outcome"
      ],
      "properties": {
        "nodeid": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "$ref": "#/$defs/testOutcome"
        }
      },
      "additionalProperties": false
    },
    "lineageResult": {
      "type": "object",
      "required": [
        "result",
        "test_nodeid",
        "observed_chain"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "test_nodeid": {
          "type": "string",
          "minLength": 1
        },
        "observed_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "stageResult": {
      "type": "object",
      "required": [
        "stage_id",
        "passed",
        "failed",
        "tests"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testCase"
          }
        },
        "lineage": {
          "$ref": "#/$defs/lineageResult"
        }
      },
      "additionalProperties": false
    },
    "testSummary": {
      "type": "object",
      "required": [
        "passed",
        "failed",
        "errors",
        "skipped",
        "xfailed",
        "xpassed"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "xfailed": {
          "type": "integer",
          "minimum": 0
        },
        "xpassed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "additionalProperties": false
    },
    "testRun": {
      "type": "object",
      "required": [
        "command",
        "exit_code",
        "duration_seconds",
        "summary"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "summary": {
          "$ref": "#/$defs/testSummary"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "runtimeEvidence": {
      "type": "object",
      "required": [
        "schema_version",
        "repository",
        "commit_sha",
        "timestamp",
        "test_run",
        "stage_results"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        },
        "test_run": {
          "$ref": "#/$defs/testRun"
        },
        "stage_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stageResult"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

      "Variables and outputs",
      "Institutional/funder requirements"
    ],
    "operations": [
      "Define population/sample or system",
      "Select formats and schema",
      "Naming and versioning plan",
      "Metadata/provenance planning",
      "Storage/backup/sharing plan"
    ],
    "outputs": [
      "Protocol",
      "DMP/DMS Plan",
      "Initial data dictionary",
      "Naming/versioning convention",
      "Quality plan"
    ],
    "failures": [
      {
        "t": "Defining variables after collection begins",
        "d": "Increases the risk of inconsistency, bias, and retrospective reinterpretation."

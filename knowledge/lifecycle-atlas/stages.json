  {
    "id": "plan",
    "num": "02",
    "name": "Study Design & Data Management Planning",
    "en": "Study Design & Data Management Planning",
    "icon": "🧩",
    "risk": 78,
    "purpose": "Translate the research question into an executable protocol and a data plan that defines in advance what will be collected and how it will be described, stored, and shared.",
